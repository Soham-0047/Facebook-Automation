# ------------------------------------------------------------------
# India Tech News Bot v5.0 - environment template
# Copy to .env (local) or paste into Colab Secrets / GitHub Secrets.
# Lines are KEY=VALUE; do NOT quote values.
# ------------------------------------------------------------------

# --- required -----------------------------------------------------
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=
NEWS_API_KEY=
GROQ_API_KEY=
PEXELS_API_KEY=

# --- optional -----------------------------------------------------
# Fallback LLM provider (recommended)
GEMINI_API_KEY=
# Extra news source
GNEWS_API_KEY=

# Watermark on cards, e.g. @indiatechdaily
PAGE_HANDLE=
# true = keep caption clean, post the article link as first comment
POST_LINK_AS_FIRST_COMMENT=false

# --- tuning (safe defaults; uncomment to change) ------------------
# MIN_ENGAGEMENT_SCORE_TO_POST=8
# QUIET_HOURS=20
# QUIET_RELAX_DROP=3
# BENGALI_PROBABILITY=0.5
# BENGALI_MAX_PER_DAY=2
# FB_API_VERSION=v21.0
# BOT_STATE_PATH=
# BOT_FONT_DIR=

# --- LLM model chains (v5.1 defaults below; edit if a provider
#     deprecates models again - check console.groq.com/docs/models) --
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest
