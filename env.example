# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git or paste it in chat.

# ---- required to post ----
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FB_PAGE_ID=your_facebook_page_id

# ---- content sources ----
NEWS_API_KEY=your_newsapi_key            # recommended (newsapi.org, free tier)
GNEWS_API_KEY=your_gnews_key             # optional extra source (gnews.io)

# ---- LLM commentary (at least one required for posting) ----
# Groq free tier: console.groq.com, no card needed
GROQ_API_KEY=your_groq_key
# GROQ_MODELS=comma,separated,fallback,list   # override the model chain
GEMINI_API_KEY=your_gemini_key           # optional secondary provider

# ---- images ----
PEXELS_API_KEY=your_pexels_key           # strongly recommended (photo cards)

# ---- optional page branding / behaviour ----
PAGE_HANDLE=@yourpagehandle              # printed on cards
# POST_LINK_AS_FIRST_COMMENT=true         # link as comment instead of body

# ---- optional tuning (defaults are sane) ----
# MIN_ENGAGEMENT_SCORE_TO_POST=9          # quality bar
# MAX_PER_CATEGORY_PER_DAY=2              # v5.4 topic diversity cap (0 = off)
# SMART_TAGS=true                         # v5.4 hashtag safety net
# BENGALI_PROBABILITY=0.18                # chance of a Bengali companion post
# BENGALI_MAX_PER_DAY=1
# QUIET_HOURS=20                          # silence -> relax the bar
# QUIET_RELAX_DROP=3
# FB_API_VERSION=v21.0
# HTTP_TIMEOUT=25
# SUPERSAMPLE=2
