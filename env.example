# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git or paste it in chat.
#
# v5.6: the page is now WORLDWIDE trending + entertainment news
# (movies, music, sports, celebs, gaming, viral, space, tech launches).
# A built-in explicit-content firewall keeps everything family-friendly -
# no extra config needed for that.

# ---- required to post ----
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FB_PAGE_ID=your_facebook_page_id

# ---- content sources ----
NEWS_API_KEY=your_newsapi_key            # recommended (newsapi.org, free tier)
GNEWS_API_KEY=your_gnews_key             # optional extra source (gnews.io)

# ---- LLM commentary (at least one required for posting) ----
# Groq free tier: console.groq.com, no card needed
GROQ_API_KEY=your_groq_key
# GROQ_MODELS=comma,separated,fallback,list   # override the model chain
GEMINI_API_KEY=your_gemini_key           # optional secondary provider

# ---- images ----
PEXELS_API_KEY=your_pexels_key           # strongly recommended (photo cards)

# ---- optional page branding / behaviour ----
PAGE_HANDLE=@yourpagehandle              # printed on cards
# POST_LINK_AS_FIRST_COMMENT=true         # link as comment instead of body

# ---- optional tuning (defaults are sane) ----
# MIN_ENGAGEMENT_SCORE_TO_POST=9          # quality bar
# MAX_PER_CATEGORY_PER_DAY=2              # v5.4 topic diversity cap (0 = off)
# SMART_TAGS=true                         # v5.4 hashtag safety net

# ---- v5.5 human-touch tuning ----
# ENGAGE_HOOK_PROBABILITY=0.75            # share of posts that end with a CTA hook
# TEXT_POST_PROBABILITY=0.15              # share of conversational posts with no image card
# SQUARE_CARD_PROBABILITY=0.35            # share of 1080x1080 squares mixed into the feed
# ENGAGE_MAX_REPLIES=4                    # --engage: max comment replies per pass
# ENGAGE_LIKE_COMMENTS=6                  # --engage: max comment likes per pass
# ENGAGE_COMMENTS_PER_POST=20             # --engage: comments fetched per post

# ---- v5.7 engagement engine ----
# SPECIAL_POSTS_ENABLED=true              # master switch: trivia / this-or-that / riddles
# TRIVIA_PROBABILITY=0.16                 # share of runs that become a TRIVIA DROP
# VS_PROBABILITY=0.12                     # share of runs that become a THIS OR THAT battle
# RIDDLE_PROBABILITY=0.08                 # share of runs that become a GUESS THE TITLE riddle
# MAX_SPECIALS_PER_DAY=2                  # hard daily cap on interactive specials
# CAROUSEL_ENABLED=true                   # multi-photo swipeable carousels
# CAROUSEL_PROBABILITY=0.20               # share of photo posts that become carousels
# CAROUSEL_MAX_PHOTOS=3                   # slides per carousel (headline card + 2 photos)
# TEMPLATE_CAPTION_FALLBACK=true          # keep posting hand-written captions if both LLMs are down

# ---- v5.8 AI image engine + editorial pipeline ----
# AI images: Pollinations.ai serving the open-source FLUX model. FREE, NO API
# KEY, no signup. Every AI card is unique to the headline - no other page can
# repost the same art. On any failure the stock-photo (Pexels) flow takes over.
# AI_IMAGE_ENABLED=true                    # master switch for AI-generated cards
# AI_IMAGE_PROBABILITY=0.45                # share of photo cards that use AI art (rest: Pexels)
# AI_IMAGE_TIMEOUT=90                      # seconds to wait for one FLUX generation
# AI_IMAGE_RETRY_WAIT=32                   # free tier is ~1 image/30s per IP - one patient retry
# EDITOR_PASS_ENABLED=true                # second-pass "viral editor" rewrite of every caption
# POLLINATIONS_TEXT_ENABLED=true          # keyless tier-3 LLM (only used if Groq AND Gemini are down)
# CINEMATIC_GRADE_PROBABILITY=0.22        # share of stock photos that get the teal-orange movie grade

# ---- v5.9 genuine voice + retention engine ----
# The page optimises for GENUINE feel + follower retention: captions pass an
# authenticity gate, developing stories get Part 2/UPDATE follow-up posts,
# specials run in fixed daily slots, and follow asks stay tasteful (capped).
# GENUINE_VOICE=true                     # authenticity gate + genuine prompts + anti-echo
# FOLLOWUP_ENABLED=true                  # Part 2 / UPDATE series (the page remembers)
# MAX_FOLLOWUPS_PER_DAY=1                # daily cap on follow-up posts
# FOLLOW_CTA_PROBABILITY=0.28            # chance of a follow ask (max 1 organic/day)
# SPECIALS_WINDOWS=11-16,20-24           # IST hours when trivia/riddles fire (empty = any)
# SOFT_SIGNOFF_PROBABILITY=0.35          # share of CTA slots that are soft sign-offs
# ENGAGE_HOOK_PROBABILITY=0.55            # share of posts ending with a CTA (softened v5.9)
# WARM_GRADE_PROBABILITY=0.25            # share of stock photos with the warm bright grade

# BENGALI_PROBABILITY=0.18                # chance of a Bengali companion post
# BENGALI_MAX_PER_DAY=1
# QUIET_HOURS=20                          # silence -> relax the bar
# QUIET_RELAX_DROP=3
# FB_API_VERSION=v21.0
# HTTP_TIMEOUT=25
# SUPERSAMPLE=2
