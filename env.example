# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git or paste it in chat.

FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FB_PAGE_ID=your_facebook_page_id
NEWS_API_KEY=your_newsapi_key
STABILITY_API_KEY=your_stability_ai_key

# Optional -- free at console.groq.com, no card required.
# Enables the smarter, fact-grounded analysis paragraph. Without it,
# the bot silently falls back to the built-in canned analysis pool.
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY

# Optional overrides
POSTED_FILE=posted_articles.json
LOG_FILE=news_bot.log
